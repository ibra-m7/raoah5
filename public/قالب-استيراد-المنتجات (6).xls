    <Cell><Data ss:Type="String">لا</Data></Cell>
    <Cell><Data ss:Type="String">نعم أو لا</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell ss:StyleID="s64"><Data ss:Type="String">ظاهر</Data></Cell>
    <Cell><Data ss:Type="String">لا</Data></Cell>
