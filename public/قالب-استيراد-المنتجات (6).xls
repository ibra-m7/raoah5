 <Worksheet ss:Name="التعليمات">
  <Table ss:ExpandedColumnCount="3" ss:ExpandedRowCount="26" x:FullColumns="1"
   x:FullRows="1" ss:StyleID="s62" ss:DefaultColumnWidth="52.8"
   ss:DefaultRowHeight="24.6">
   <Column ss:StyleID="s62" ss:AutoFitWidth="0" ss:Width="90"/>
   <Column ss:StyleID="s62" ss:AutoFitWidth="0" ss:Width="70.2"/>
   <Column ss:StyleID="s62" ss:AutoFitWidth="0" ss:Width="420"/>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell ss:StyleID="s65"><Data ss:Type="String">كيف تستخدم القالب</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell><Data ss:Type="String">1) لا تحذف صف العناوين الأول ولا تغيّر أسماء الأعمدة.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell><Data ss:Type="String">2) الأعمدة الحمراء إلزامية في كل صف. الخضراء اختيارية.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell><Data ss:Type="String">3) القالب يحتوي 50 منتجاً بأسماء حقيقية (إلكترونيات وإكسسوارات). الباركود من 1 إلى 50 — عدّل الأسماء والأسعار حسب متجرك.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell><Data ss:Type="String">4) سمِّ صور المنتجات برقم الباركود مثل 3.png أو 3.jpg وضعها في ملف ZIP.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell><Data ss:Type="String">5) ارفع ملف Excel مع ملف ZIP من صفحة الاستيراد لربط كل صورة بمنتجها تلقائياً.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell><Data ss:Type="String">6) انسخ اسم القسم من ورقة «الأقسام» كما هو بدون زيادة مسافات.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell><Data ss:Type="String">7) إذا وضعت «رمز المنتج» أو «الباركود» لمنتج موجود مسبقاً سيتم تحديثه بدل إنشاء صف جديد.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell ss:StyleID="s65"><Data ss:Type="String">الأعمدة</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell ss:StyleID="s64"><Data ss:Type="String">العمود</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">إلزامي؟</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">الشرح</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell ss:StyleID="s63"><Data ss:Type="String">الاسم</Data></Cell>
    <Cell><Data ss:Type="String">نعم</Data></Cell>
    <Cell><Data ss:Type="String">اسم المنتج كما سيظهر في التطبيق</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell ss:StyleID="s63"><Data ss:Type="String">القسم</Data></Cell>
    <Cell><Data ss:Type="String">نعم</Data></Cell>
    <Cell><Data ss:Type="String">انسخ الاسم حرفياً من ورقة الأقسام</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell ss:StyleID="s63"><Data ss:Type="String">السعر</Data></Cell>
    <Cell><Data ss:Type="String">نعم</Data></Cell>
    <Cell><Data ss:Type="String">السعر الأصلي بالريال، أرقام فقط</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell ss:StyleID="s63"><Data ss:Type="String">المخزون</Data></Cell>
    <Cell><Data ss:Type="String">نعم</Data></Cell>
    <Cell><Data ss:Type="String">الكمية المتوفرة</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell ss:StyleID="s64"><Data ss:Type="String">الباركود</Data></Cell>
    <Cell><Data ss:Type="String">لا</Data></Cell>
    <Cell><Data ss:Type="String">رقم يطابق اسم الصورة في ZIP مثل 3.png للمنتج ذي الباركود 3</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell ss:StyleID="s64"><Data ss:Type="String">رمز المنتج</Data></Cell>
    <Cell><Data ss:Type="String">لا</Data></Cell>
    <Cell><Data ss:Type="String">اختياري. إن وُجد منتج بنفس الرمز يُحدَّث بدل إنشائه</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell ss:StyleID="s64"><Data ss:Type="String">سعر العرض</Data></Cell>
    <Cell><Data ss:Type="String">لا</Data></Cell>
    <Cell><Data ss:Type="String">أقل من السعر الأصلي ليظهر في العروض</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell ss:StyleID="s64"><Data ss:Type="String">الوصف</Data></Cell>
    <Cell><Data ss:Type="String">لا</Data></Cell>
    <Cell><Data ss:Type="String">وصف قصير للمنتج</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell ss:StyleID="s64"><Data ss:Type="String">رابط الصورة</Data></Cell>
    <Cell><Data ss:Type="String">لا</Data></Cell>
    <Cell><Data ss:Type="String">رابط مباشر إن لم تستخدم ZIP</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
    <Cell ss:StyleID="s64"><Data ss:Type="String">الفوائد</Data></Cell>
    <Cell><Data ss:Type="String">لا</Data></Cell>
    <Cell><Data ss:Type="String">افصل كل فائدة بـ |</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="22.05">
