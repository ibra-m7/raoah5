<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet" xmlns:html="http://www.w3.org/TR/REC-html40"><DocumentProperties xmlns="urn:schemas-microsoft-com:office:office"><Author>روعة الخمسة</Author></DocumentProperties><Styles><Style ss:ID="Default"><Alignment ss:Horizontal="Right" ss:ReadingOrder="RightToLeft" ss:WrapText="1"/><Font ss:FontName="Cairo" ss:Size="11"/></Style><Style ss:ID="Required"><Alignment ss:Horizontal="Center" ss:WrapText="1"/><Font ss:Bold="1" ss:Color="#9B1C1C" ss:Size="11"/><Interior ss:Color="#FDECEC" ss:Pattern="Solid"/></Style><Style ss:ID="Optional"><Alignment ss:Horizontal="Center" ss:WrapText="1"/><Font ss:Bold="1" ss:Color="#166534" ss:Size="11"/><Interior ss:Color="#E8F8EC" ss:Pattern="Solid"/></Style><Style ss:ID="Title"><Font ss:Bold="1" ss:Size="14" ss:Color="#166534"/></Style></Styles><Worksheet ss:Name="المنتجات"><Table><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="160"/><Column ss:AutoFitWidth="0" ss:Width="160"/><Column ss:AutoFitWidth="0" ss:Width="160"/><Column ss:AutoFitWidth="0" ss:Width="160"/><Column ss:AutoFitWidth="0" ss:Width="160"/><Column ss:AutoFitWidth="0" ss:Width="160"/><Column ss:AutoFitWidth="0" ss:Width="160"/><Column ss:AutoFitWidth="0" ss:Width="160"/><Column ss:AutoFitWidth="0" ss:Width="160"/><Column ss:AutoFitWidth="0" ss:Width="160"/><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Required"><Data ss:Type="String">الاسم *</Data></Cell><Cell ss:StyleID="Required"><Data ss:Type="String">القسم *</Data></Cell><Cell ss:StyleID="Required"><Data ss:Type="String">السعر *</Data></Cell><Cell ss:StyleID="Required"><Data ss:Type="String">المخزون *</Data></Cell><Cell ss:StyleID="Optional"><Data ss:Type="String">رمز المنتج</Data></Cell><Cell ss:StyleID="Optional"><Data ss:Type="String">سعر العرض</Data></Cell><Cell ss:StyleID="Optional"><Data ss:Type="String">الوصف</Data></Cell><Cell ss:StyleID="Optional"><Data ss:Type="String">رابط الصورة</Data></Cell><Cell ss:StyleID="Optional"><Data ss:Type="String">الفوائد</Data></Cell><Cell ss:StyleID="Optional"><Data ss:Type="String">كلمات البحث</Data></Cell><Cell ss:StyleID="Optional"><Data ss:Type="String">طريقة الاستخدام</Data></Cell><Cell ss:StyleID="Optional"><Data ss:Type="String">مميز</Data></Cell><Cell ss:StyleID="Optional"><Data ss:Type="String">ظاهر</Data></Cell><Cell ss:StyleID="Optional"><Data ss:Type="String">الترتيب</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell><Data ss:Type="String">زيت الزيتون البكر 500مل</Data></Cell><Cell><Data ss:Type="String">الحليب والألبان</Data></Cell><Cell><Data ss:Type="String">45.5</Data></Cell><Cell><Data ss:Type="String">80</Data></Cell><Cell><Data ss:Type="String">OIL-500</Data></Cell><Cell><Data ss:Type="String">39.9</Data></Cell><Cell><Data ss:Type="String">زيت زيتون بكر ممتاز من مزارع الجوف</Data></Cell><Cell><Data ss:Type="String">https://example.com/oil.jpg</Data></Cell><Cell><Data ss:Type="String">غني بمضادات الأكسدة | مناسب للسلطات</Data></Cell><Cell><Data ss:Type="String">زيت, زيتون, عضوي</Data></Cell><Cell><Data ss:Type="String">يُستخدم بارداً مع السلطات</Data></Cell><Cell><Data ss:Type="String">نعم</Data></Cell><Cell><Data ss:Type="String">نعم</Data></Cell><Cell><Data ss:Type="String">10</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell><Data ss:Type="String">منظف أرضيات برائحة اللافندر</Data></Cell><Cell><Data ss:Type="String">الخضروات والفواكه</Data></Cell><Cell><Data ss:Type="String">18</Data></Cell><Cell><Data ss:Type="String">120</Data></Cell><Cell><Data ss:Type="String">CLN-LAV</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">ينظف الأرضيات بلمعان ويدوم أثر العطر</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">رائحة ثابتة | مناسب للسيراميك</Data></Cell><Cell><Data ss:Type="String">منظف, أرضيات</Data></Cell><Cell><Data ss:Type="String">أضف غطاءً إلى دلو ماء وامسح الأرض</Data></Cell><Cell><Data ss:Type="String">لا</Data></Cell><Cell><Data ss:Type="String">نعم</Data></Cell><Cell><Data ss:Type="String">20</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><DisplayRightToLeft/><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions></Worksheet><Worksheet ss:Name="التعليمات"><Table><Column ss:AutoFitWidth="0" ss:Width="90"/><Column ss:AutoFitWidth="0" ss:Width="70"/><Column ss:AutoFitWidth="0" ss:Width="420"/><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Title"><Data ss:Type="String">كيف تستخدم القالب</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell><Data ss:Type="String">1) لا تحذف صف العناوين الأول ولا تغيّر أسماء الأعمدة.</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell><Data ss:Type="String">2) الأعمدة الحمراء إلزامية في كل صف. الخضراء اختيارية.</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell><Data ss:Type="String">3) انسخ اسم القسم من ورقة «الأقسام» كما هو بدون زيادة مسافات.</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell><Data ss:Type="String">4) إذا وضعت «رمز المنتج» لمنتج موجود مسبقاً سيتم تحديثه بدل إنشاء صف جديد.</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell><Data ss:Type="String">5) احفظ الملف ثم ارفعه من: المنتجات ← استيراد Excel. يمكن أيضاً الحفظ كـ CSV UTF-8.</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell><Data ss:Type="String"></Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Title"><Data ss:Type="String">الأعمدة</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Optional"><Data ss:Type="String">العمود</Data></Cell><Cell ss:StyleID="Optional"><Data ss:Type="String">إلزامي؟</Data></Cell><Cell ss:StyleID="Optional"><Data ss:Type="String">الشرح</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Required"><Data ss:Type="String">الاسم</Data></Cell><Cell><Data ss:Type="String">نعم</Data></Cell><Cell><Data ss:Type="String">اسم المنتج كما سيظهر في التطبيق</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Required"><Data ss:Type="String">القسم</Data></Cell><Cell><Data ss:Type="String">نعم</Data></Cell><Cell><Data ss:Type="String">انسخ الاسم حرفياً من ورقة الأقسام</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Required"><Data ss:Type="String">السعر</Data></Cell><Cell><Data ss:Type="String">نعم</Data></Cell><Cell><Data ss:Type="String">السعر الأصلي بالريال، أرقام فقط</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Required"><Data ss:Type="String">المخزون</Data></Cell><Cell><Data ss:Type="String">نعم</Data></Cell><Cell><Data ss:Type="String">الكمية المتوفرة</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Optional"><Data ss:Type="String">رمز المنتج</Data></Cell><Cell><Data ss:Type="String">لا</Data></Cell><Cell><Data ss:Type="String">اختياري. إن وُجد منتج بنفس الرمز يُحدَّث بدل إنشائه</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Optional"><Data ss:Type="String">سعر العرض</Data></Cell><Cell><Data ss:Type="String">لا</Data></Cell><Cell><Data ss:Type="String">أقل من السعر الأصلي ليظهر في العروض</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Optional"><Data ss:Type="String">الوصف</Data></Cell><Cell><Data ss:Type="String">لا</Data></Cell><Cell><Data ss:Type="String">وصف قصير للمنتج</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Optional"><Data ss:Type="String">رابط الصورة</Data></Cell><Cell><Data ss:Type="String">لا</Data></Cell><Cell><Data ss:Type="String">رابط مباشر لصورة المنتج (https://...)</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Optional"><Data ss:Type="String">الفوائد</Data></Cell><Cell><Data ss:Type="String">لا</Data></Cell><Cell><Data ss:Type="String">افصل كل فائدة بـ |</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Optional"><Data ss:Type="String">كلمات البحث</Data></Cell><Cell><Data ss:Type="String">لا</Data></Cell><Cell><Data ss:Type="String">افصل بفاصلة</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Optional"><Data ss:Type="String">طريقة الاستخدام</Data></Cell><Cell><Data ss:Type="String">لا</Data></Cell><Cell><Data ss:Type="String">نص حر</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Optional"><Data ss:Type="String">مميز</Data></Cell><Cell><Data ss:Type="String">لا</Data></Cell><Cell><Data ss:Type="String">نعم أو لا</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Optional"><Data ss:Type="String">ظاهر</Data></Cell><Cell><Data ss:Type="String">لا</Data></Cell><Cell><Data ss:Type="String">نعم أو لا — الافتراضي نعم</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Optional"><Data ss:Type="String">الترتيب</Data></Cell><Cell><Data ss:Type="String">لا</Data></Cell><Cell><Data ss:Type="String">رقم أصغر يظهر أولاً</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><DisplayRightToLeft/></WorksheetOptions></Worksheet><Worksheet ss:Name="الأقسام"><Table><Column ss:AutoFitWidth="0" ss:Width="220"/><Column ss:AutoFitWidth="0" ss:Width="160"/><Row ss:AutoFitHeight="1" ss:Height="22"><Cell ss:StyleID="Optional"><Data ss:Type="String">اسم القسم (انسخه لعمود القسم)</Data></Cell><Cell ss:StyleID="Optional"><Data ss:Type="String">القسم الأب</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell><Data ss:Type="String">الحليب والألبان</Data></Cell><Cell><Data ss:Type="String">—</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell><Data ss:Type="String">الخضروات والفواكه</Data></Cell><Cell><Data ss:Type="String">—</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell><Data ss:Type="String">الزيوت والصلصات</Data></Cell><Cell><Data ss:Type="String">—</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell><Data ss:Type="String">رائجة اليوم</Data></Cell><Cell><Data ss:Type="String">—</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell><Data ss:Type="String">شاي وقهوة</Data></Cell><Cell><Data ss:Type="String">—</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell><Data ss:Type="String">عصائر طبيعية</Data></Cell><Cell><Data ss:Type="String">—</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell><Data ss:Type="String">مشروبات غازية</Data></Cell><Cell><Data ss:Type="String">—</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell><Data ss:Type="String">معطرات الجو</Data></Cell><Cell><Data ss:Type="String">رائجة اليوم</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell><Data ss:Type="String">منظفات المطبخ</Data></Cell><Cell><Data ss:Type="String">رائجة اليوم</Data></Cell></Row><Row ss:AutoFitHeight="1" ss:Height="22"><Cell><Data ss:Type="String">مياه ومعدنية</Data></Cell><Cell><Data ss:Type="String">—</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><DisplayRightToLeft/><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions></Worksheet></Workbook>