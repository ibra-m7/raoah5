	<!-- speech_to_text: التعرف على الكلام -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>يحتاج التطبيق إذن التعرف على الكلام لتحويل صوتك إلى نص وإرساله للمساعد الذكي</string>
	<!-- speech_to_text + flutter_tts: الوصول للميكروفون -->
