# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# مثال على ملف البيئة — آمن للـ Git
# انسخ هذا الملف وسمّه .env ثم ضع قيمك الحقيقية
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

GEMINI_API_KEY=your_gemini_api_key_here

# محاكي أندرويد: http://10.0.2.2:8000/api
# جهاز حقيقي: http://IP-جهازك:8000/api
API_BASE_URL=http://10.0.2.2:8000/api
